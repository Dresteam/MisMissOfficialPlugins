{
    "cmd_qiuqian": {
        "type": "string",
        "default": "求签",
        "description": "求签指令名"
    },
    "cmd_qiuqian_aliases": {
        "type": "array",
        "default": ["抽签"],
        "description": "求签指令别名（精确匹配）"
    },
    "enabled_rooms": {
        "type": "array",
        "default": [],
        "description": "启用本插件的直播间 ID 列表（空=全部）"
    },
    "live_fetch": {
        "type": "boolean",
        "default": true,
        "description": "抽中未缓存的签号时实时抓取解签（关闭则仅从本地签文抽取）"
    },
    "fetch_fail_text": {
        "type": "string",
        "default": "求签失败啦，稍后再来试试吧~",
        "description": "实时抓取失败且无任何本地签文时的提示"
    },
    "result_line": {
        "type": "string",
        "default": "求签结果：您抽到的是第{n}签【{f}】",
        "description": "结果行模板（{n}=中文签号，{f}=吉凶）"
    },
    "poem_line": {
        "type": "string",
        "default": "签诗：{p}",
        "description": "签诗行模板（{p}=签诗）"
    },
    "intpn_line": {
        "type": "string",
        "default": "解签：{i}",
        "description": "解签行模板（{i}=解签一）"
    },
    "show_intpn_2": {
        "type": "boolean",
        "default": false,
        "description": "是否追加显示解签二"
    },
    "intpn_2_line": {
        "type": "string",
        "default": "解签二：{i}",
        "description": "解签二行模板（{i}=解签二）"
    },
    "separator": {
        "type": "string",
        "default": "♱⋰ ⋱✮⋰ ⋱♱⋰ ⋱✮⋰ ⋱♱⋰ ⋱✮⋰",
        "description": "消息底部装饰线"
    }
}
