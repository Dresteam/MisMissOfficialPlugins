{
    "thank_prefix": {
        "group": "文案",
        "type": "string",
        "default": "感谢小可爱的投喂订单：",
        "description": "@用户名 之后的感谢语前缀"
    },
    "header_art": {
        "group": "高级",
        "type": "string",
        "default": "　ᕱ ⑅ ᕱ\n　(,,>᎑<,,) 谢谢礼物！\n╭♡★-- ℒ ℴ 𝓋 ℯ --★ʚ♡ɞ╮\n❀",
        "description": "消息头部的 ASCII 装饰画"
    },
    "gift_line_format": {
        "group": "文案",
        "type": "string",
        "default": "┆　• {gift_name}：{gift_emoji}*{gift_num}个",
        "description": "礼物行格式（{gift_name}/{gift_emoji}/{gift_num} 会被替换）"
    },
    "value_line_format": {
        "group": "文案",
        "type": "string",
        "default": "价值：{gift_value}💗",
        "description": "非猫粮/猫罐头且总价值大于 0 时在 frame 下方显示的礼物价值行（{gift_value} 会被替换）"
    },
    "lucky_round_format": {
        "group": "文案",
        "type": "string",
        "default": "🍀 本轮幸运值：{lucky_percent}%",
        "description": "幸运礼物本轮幸运值行（{lucky_percent} 会被替换）"
    },
    "lucky_total_format": {
        "group": "文案",
        "type": "string",
        "default": "📊 累计幸运值：{total_lucky_percent}%",
        "description": "幸运礼物累计幸运值行（{total_lucky_percent} 会被替换）"
    },
    "footer_art": {
        "group": "高级",
        "type": "string",
        "default": "╰ʚ♡ɞ┈┈┈┈┈┈┈♡╯",
        "description": "消息底部的 ASCII 装饰画"
    },
    "cat_food_names": {
        "group": "高级",
        "type": "array",
        "default": [
            "猫粮",
            "猫罐头"
        ],
        "description": "视为猫粮/猫罐头的礼物名称列表（精确匹配）"
    },
    "cat_food_emoji": {
        "group": "高级",
        "type": "string",
        "default": "🐱",
        "description": "猫粮类礼物使用的 emoji（默认 🐱）"
    },
    "default_gift_emoji": {
        "group": "高级",
        "type": "string",
        "default": "🎁",
        "description": "非猫粮类礼物使用的默认 emoji（默认 🎁）"
    },
    "gift_emoji_map": {
        "group": "高级",
        "type": "object",
        "default": {},
        "description": "特定礼物名称 → emoji 的映射（优先级高于 cat_food_names 和 default_gift_emoji）"
    },
    "batch_enabled": {
        "group": "常用",
        "type": "boolean",
        "default": true,
        "description": "是否启用礼物聚合：同一用户在延迟时间内连续送礼时合并为一条感谢消息"
    },
    "batch_delay": {
        "group": "常用",
        "type": "float",
        "default": 3.0,
        "description": "礼物聚合延迟（秒）：在此时间内同一用户的新礼物会重置计时并合并"
    },
    "cross_gift_enabled": {
        "group": "常用",
        "type": "boolean",
        "default": true,
        "description": "是否感谢跨房礼物：开启后，大厅中观众送给其他麦（非本直播间）的礼物也会发送感谢消息（默认开启）"
    },
    "cross_gift_line": {
        "group": "文案",
        "type": "string",
        "default": "送给：{target}",
        "description": "跨房礼物的受赠主播标注行，输出在装饰框外 footer 之后（{target} 替换为受赠主播昵称；留空则不输出该行）"
    },
    "board_cmd_white": {
        "group": "常用",
        "type": "string",
        "default": "白榜",
        "description": "白榜指令名（幸运值从高到低）"
    },
    "board_cmd_black": {
        "group": "常用",
        "type": "string",
        "default": "黑榜",
        "description": "黑榜指令名（幸运值从高到低）"
    },
    "board_cmd_both": {
        "group": "常用",
        "type": "string",
        "default": "黑白榜",
        "description": "黑白榜指令名（福星+煤球混合榜单，降序）"
    },
    "board_admin_only": {
        "group": "常用",
        "type": "boolean",
        "default": false,
        "description": "榜单指令是否仅管理员可用"
    },
    "board_page_size": {
        "group": "常用",
        "type": "int",
        "default": 8,
        "description": "榜单每页条目数"
    },
    "board_threshold": {
        "group": "常用",
        "type": "float",
        "default": 100.0,
        "description": "白榜/黑榜幸运值分界阈值：白榜显示 ≥ 阈值的用户，黑榜显示 < 阈值的用户（设为 0 时黑榜不筛选、包含全部用户）"
    },
    "board_title_white": {
        "group": "文案",
        "type": "string",
        "default": "白榜",
        "description": "白榜标题文本"
    },
    "board_white_header": {
        "group": "文案",
        "type": "string",
        "default": "🌕“看看谁是最白的小朋友",
        "description": "白榜头部文案"
    },
    "board_white_title": {
        "group": "文案",
        "type": "string",
        "default": "———— ✨{type}✨ ————",
        "description": "白榜标题行模板"
    },
    "board_white_teaser": {
        "group": "文案",
        "type": "string",
        "default": "",
        "description": "白榜调侃文案行（留空则不显示）"
    },
    "board_white_subtitle": {
        "group": "文案",
        "type": "string",
        "default": "——— ̗̀♡ʚ 福星榜 ɞ♡ ̖́———",
        "description": "白榜副标题行"
    },
    "board_white_item_line": {
        "group": "文案",
        "type": "string",
        "default": "⭐️小福星：@{name}    {value}%",
        "description": "白榜条目行模板（{name}=用户名，{value}=幸运值，固定保留一位小数）"
    },
    "board_white_page_line": {
        "group": "文案",
        "type": "string",
        "default": "𓆝𓆟𓆜𓆞𓆡𓆝𓆟𓆜𓆞（{page}/{pages}页）",
        "description": "白榜页码行模板（{page}=当前页，{pages}=总页数）"
    },
    "board_white_empty_text": {
        "group": "文案",
        "type": "string",
        "default": "@{u} 还没有白白的小朋友上榜哦~",
        "description": "白榜空榜提示（{u}=查询者用户名）"
    },
    "board_black_header": {
        "group": "文案",
        "type": "string",
        "default": "🌚“看看谁是最黑的小朋友",
        "description": "黑榜头部文案"
    },
    "board_black_title": {
        "group": "文案",
        "type": "string",
        "default": "———— ✨黑榜✨ ————",
        "description": "黑榜标题行"
    },
    "board_black_teaser": {
        "group": "文案",
        "type": "string",
        "default": "✰黑黑的小朋友o(o･`з´o)ﾉ!!!，快去让主播洗个手祝你白白哒叭~",
        "description": "黑榜调侃文案行"
    },
    "board_black_subtitle": {
        "group": "文案",
